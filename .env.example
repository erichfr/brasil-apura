APP_NAME="Brasil Apura"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=brasil_apura
DB_USERNAME=brasil_apura
DB_PASSWORD=
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
TSE_SYNC_ENABLED=false
TSE_POLL_SECONDS=60
TSE_TIMEOUT_SECONDS=15
TSE_CONNECT_TIMEOUT_SECONDS=5
TSE_STALE_AFTER_SECONDS=180
TSE_MAX_BODY_BYTES=10485760
TSE_FINAL_POLL_SECONDS=3600
